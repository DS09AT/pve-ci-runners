[Unit]
Description=pve-ci-runners: build the next runner template
Documentation=https://github.com/DS09AT/pve-ci-runners
After=network-online.target pve-cluster.service
Wants=network-online.target
ConditionPathExists=/etc/pve-ci-runners/config.toml

[Service]
Type=oneshot
ExecStart=/usr/bin/pve-ci-runners template build
TimeoutStartSec=3h
UMask=0077
StateDirectory=pve-ci-runners
StateDirectoryMode=0700
ReadWritePaths=/etc/pve
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=full
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectClock=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
